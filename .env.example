# Copie para .env.local durante o desenvolvimento.
# No EasyPanel/Vercel, cadastre estes valores nas variáveis do serviço.
DATABASE_URL=postgresql://usuario:senha@host:5432/ortofernandes

# Use "require" quando o PostgreSQL estiver exposto com TLS.
# Use "disable" apenas na rede privada do EasyPanel, sem tráfego pela internet.
DATABASE_SSL=require

# Limite pequeno evita excesso de conexões em ambientes serverless.
DATABASE_POOL_MAX=5

MINIO_SERVER_URL=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

MINIO_BUCKET=ortofernandes
MINIO_REGION=us-east-1
MINIO_USE_SSL=true
